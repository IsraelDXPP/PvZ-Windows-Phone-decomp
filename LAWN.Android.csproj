    <Compile Include="Properties\AssemblyInfo.cs" />
    <EmbeddedResource Include="Lawn.Strings.resx" />
    <AndroidAsset Include="Content\**\*.*" />
    <AndroidAsset Include="resources.xml;todresources.xml;LawnStrings_*.txt" />
    <AndroidResource Include="Platforms\Android\Resources\**\*.xml" />
    <AndroidManifest Include="Platforms\Android\AndroidManifest.xml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.1.303" />
  </ItemGroup>
</Project>
